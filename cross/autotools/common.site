# Shared part of the autotools CONFIG_SITE files (amd64.site, arm64.site).
#
# Expects in the environment (exported by build-printing-support.sh):
#   SYSROOT       the staged NextBSD base (compat), with the userland and
#                 gnustep-support artifacts and earlier components installed
#   CROSS_BINDIR  the toolchain image's pinned clang/lld 19.1.7
#   PS_CROSS      this directory's parent (cross/)
# and ps_triple from the per-arch file that sources this one.

: "${SYSROOT:?}" "${CROSS_BINDIR:?}" "${ps_triple:?}"

# The cross compiler. clang finds ld.lld beside itself. -fuse-ld=lld is part
# of CC, not only LDFLAGS: the libtool bundled in older releases drops it from
# link lines, and a compiler probe that links without LDFLAGS would quietly
# use the runner's ld (wrong for arm64). -Qunused-arguments keeps compile-only
# steps from warning that the linker flag is unused.
CC="$CROSS_BINDIR/clang --target=$ps_triple --sysroot=$SYSROOT -fuse-ld=lld -Qunused-arguments"
CXX="$CROSS_BINDIR/clang++ --target=$ps_triple --sysroot=$SYSROOT -fuse-ld=lld -Qunused-arguments"
CFLAGS="${CFLAGS:--O2 -pipe}"
CXXFLAGS="${CXXFLAGS:--O2 -pipe}"
LDFLAGS="-fuse-ld=lld ${LDFLAGS:-}"
AR="$CROSS_BINDIR/llvm-ar"
RANLIB="$CROSS_BINDIR/llvm-ranlib"
NM="$CROSS_BINDIR/llvm-nm"
STRIP="$CROSS_BINDIR/llvm-strip"
OBJCOPY="$CROSS_BINDIR/llvm-objcopy"

# Programs that run on the build host during the build use the host compiler.
CC_FOR_BUILD=cc

# pkgconf (ISC), never freedesktop's GPL pkg-config. Only the sysroot's .pc
# directories are searched, and -I/-L results are prefixed with the sysroot.
PKG_CONFIG=pkgconf
PKG_CONFIG_LIBDIR="$SYSROOT/usr/libdata/pkgconfig"
PKG_CONFIG_SYSROOT_DIR="$SYSROOT"
export PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR

# Cache answers for checks that must run a target program, common to both
# arches. Each needs a reason, e.g.:
#   name_cv_check=value   # why this is the NextBSD answer
