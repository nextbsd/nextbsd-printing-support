Description: Read the peer's credentials at the local-socket level on FreeBSD
 cupsd's PeerCred check (local-socket requests that name a user, which is
 how libcups authenticates lpadmin and friends over /var/run/cupsd) asks for
 the peer's uid with getsockopt(SOL_SOCKET, SO_PEERCRED) everywhere but
 macOS. FreeBSD has no SO_PEERCRED, so cups/http.h defines it as
 LOCAL_PEERCRED (1), and at the SOL_SOCKET level option 1 is SO_DEBUG: the
 call succeeds, writes a 4-byte int over cr_version and leaves the rest of
 the struct xucred uninitialised. cupsd then compares stack garbage with the
 user's uid ("Invalid peer credentials for "root" - got 574, expected 0", a
 different number each time) and answers Unauthorized. FreeBSD, like macOS,
 wants level 0 (SOL_LOCAL) and fills a struct xucred, which is what
 cupsd_ucred_t already is with <sys/ucred.h>; use the macOS call there.
Origin: https://cgit.freebsd.org/ports/tree/print/cups/files/patch-scheduler_auth.c
Forwarded: not-needed (Apple's CUPS is built only for macOS)
---
--- a/cups/scheduler/auth.c
+++ b/cups/scheduler/auth.c
@@ -444,11 +444,11 @@ cupsdAuthorize(cupsd_client_t *con)	/* I - Client connection */
 
     peersize = sizeof(peercred);
 
-#  ifdef __APPLE__
+#  if defined(__APPLE__) || defined(__FreeBSD__)
     if (getsockopt(httpGetFd(con->http), 0, LOCAL_PEERCRED, &peercred, &peersize))
 #  else
     if (getsockopt(httpGetFd(con->http), SOL_SOCKET, SO_PEERCRED, &peercred, &peersize))
-#  endif /* __APPLE__ */
+#  endif /* __APPLE__ || __FreeBSD__ */
     {
       cupsdLogClient(con, CUPSD_LOG_ERROR, "Unable to get peer credentials - %s", strerror(errno));
       return;
@@ -842,12 +842,12 @@ cupsdAuthorize(cupsd_client_t *con)	/* I - Client connection */
 
       peersize = sizeof(peercred);
 
-#    ifdef __APPLE__
+#    if defined(__APPLE__) || defined(__FreeBSD__)
       if (getsockopt(httpGetFd(con->http), 0, LOCAL_PEERCRED, &peercred, &peersize))
 #    else
       if (getsockopt(httpGetFd(con->http), SOL_SOCKET, SO_PEERCRED, &peercred,
                      &peersize))
-#    endif /* __APPLE__ */
+#    endif /* __APPLE__ || __FreeBSD__ */
       {
 	cupsdLogClient(con, CUPSD_LOG_ERROR, "Unable to get peer credentials - %s", strerror(errno));
       }
